{
  "tasks": [
    {
      "name": "Format check",
      "command": "dotnet",
      "args": ["format", "--verify-no-changes"],
      "include": ["**/*.cs"]
    },
    {
      "name": "ESLint",
      "command": "npx",
      "args": ["eslint", "src/"],
      "cwd": "nemesiseuchre.client",
      "include": ["**/*.ts", "**/*.tsx"]
    },
    {
      "name": "Build and Test",
      "command": "dotnet",
      "args": ["test", "--configuration", "Release", "--no-restore"]
    }
  ]
}
